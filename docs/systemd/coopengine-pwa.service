[Unit]
Description=Co-opEngine member PWA (Next.js)
After=coopengine-api.service
Wants=coopengine-api.service

[Service]
Type=simple
WorkingDirectory=/root/CoopEngine-core/apps/member-pwa
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

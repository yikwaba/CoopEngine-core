# ============================================================
# Co-opEngine environment variables (example — copy to .env)
# ============================================================

# --- API ---
PORT=3000
NODE_ENV=development
# Public API base prefix is fixed at /api/v1 in code.

# --- PostgreSQL (local docker-compose defaults) ---
DATABASE_URL=postgres://coopengine:coopengine@localhost:5432/coopengine
# Staging/production points at Supabase Postgres:
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=false

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local; Supabase Storage in staging/prod) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=coopengine
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# --- Auth (Phase 1+) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# MFA_ISSUER=Co-opEngine

# --- Providers (Phase 8+: Monnify, Smile ID, Termii) ---
# MONNIFY_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# SMILE_ID_API_KEY=
# TERMII_API_KEY=

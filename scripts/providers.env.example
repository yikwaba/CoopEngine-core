# Co-opEngine provider credentials — template.
#
# Copy to /root/coopengine/providers.env (mode 600) and fill in with
#   scripts/provider-set-key.sh <NAME>
# Never commit the real file. The systemd unit loads it as an optional
# EnvironmentFile, so an absent file simply means "dev providers".

# ---------------------------------------------------------------- Termii (SMS)
# Sender ID must be approved in the Termii dashboard (max 11 chars).
TERMII_API_KEY=
TERMII_SENDER_ID=
# Optional overrides / test hooks
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=generic
# TERMII_TIMEOUT_MS=8000
# TERMII_TEST_PHONE=+2348XXXXXXXXX   # preflight sends one test SMS when set

# ------------------------------------------------------------- Monnify (money)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Sandbox vs live endpoint
MONNIFY_BASE_URL=https://api.monnify.com
# MONNIFY_TIMEOUT_MS=10000

# ------------------------------------------------------- Feature switches
# Set by scripts/provider-switch.sh — dev keeps everything local and free.
MEMBER_OTP_PROVIDER=dev
MONNIFY_PROVIDER=dev

# ------------------------------------------------------------- Email (SMTP)
# Optional: enables real email delivery for the notification EMAIL channel.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
